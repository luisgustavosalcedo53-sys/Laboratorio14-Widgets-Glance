<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="Dispensalud · Lab 14" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MedicamentosActivity" android:exported="false" />
        <activity android:name=".HistorialActivity" android:exported="false" />
        <receiver android:name=".SimpleWidget" android:exported="true" android:label="Laboratorio · Accesos">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/simple_widget_info" />
        </receiver>
        <receiver android:name=".DispensaludWidgetReceiver" android:exported="true" android:label="Dispensalud · Mi día">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/dispensalud_widget_info" />
        </receiver>
    </application>
</manifest>
